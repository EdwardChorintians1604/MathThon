# ⚠️ ENVIRONMENT VARIABLES - DO NOT COMMIT .env FILE TO GIT!
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=generate-new-secret-key-with-python-secrets

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=maththon_db
MYSQL_PORT=3306

# Email Configuration (for password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# OpenAI Configuration (if used)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama Configuration (for local AI)
MODEL_NAME=llama3.2:1b
OLLAMA_API_URL=http://localhost:11434/api/generate

# AI System Prompt
AI_SYSTEM_PROMPT=Anda adalah asisten matematika yang membantu menyelesaikan soal secara langkah demi langkah.

# Production / Aiven Configuration
# Opsi 1: Satu Service URI dari Aiven (Rekomendasi - tinggal copy-paste dari dashboard Aiven):
# DATABASE_URL=mysql://avnadmin:your_password@mysql-xxxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Opsi 2: Atau gunakan variabel terpisah:
# MYSQL_HOST=mysql-xxxxx.aivencloud.com
# MYSQL_PORT=12345
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_password
# MYSQL_DB=defaultdb

# ALLOWED_ORIGINS=https://your-maththon.onrender.com